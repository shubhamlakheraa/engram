{
  "manifest_version": 3,
  "name": "Engram",
  "version": "0.1.0",
  "description": "Automatic spaced repetition for LeetCode. Solve once, remember forever.",

  "permissions": [
    "storage",
    "identity",
    "notifications"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.notion.com/*",
    "https://www.googleapis.com/*",
    "http://localhost:3000/*",
    "https://engram-ijh1.onrender.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/page-interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content/bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [],

  "oauth2": {
    "client_id": "871093867219-ko05ba8qsoo5dtsohdf49dp0jeld0d09.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/calendar.readonly"
    ]
  }
}
